# Server Runtime Setup
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/fixmyroad
JWT_SECRET=dev_jwt_secret_key_fixmyroad_2026_super_secure
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_IN=1

# Frontend Origin URL
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Microservice Setup
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=3000

# Notification & SMTP Setup
NOTIFICATION_DELIVERY_MODE=MOCK
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@fixmyroad.local
SMTP_PASSWORD=your_smtp_password
NOTIFICATION_FROM_EMAIL=notifications@fixmyroad.local
NOTIFICATION_FROM_NAME=FixMyRoad System

# Rate Limits
MUNICIPALITY_STATUS_RATE_LIMIT=60
FEEDBACK_RATE_LIMIT=20
REOPEN_RATE_LIMIT=10
ANALYTICS_RATE_LIMIT=60
ANALYTICS_RATE_WINDOW_MS=3600000
HEALTH_RATE_LIMIT=120
HEALTH_RATE_WINDOW_MS=3600000
EXPORT_RATE_LIMIT=20
EXPORT_RATE_WINDOW_MS=3600000

# Security & Limits
ANALYTICS_MAX_RANGE_DAYS=366
MAX_EXPORT_RECORDS=10000
SLOW_REQUEST_THRESHOLD_MS=1000
ENABLE_API_DOCS=false
